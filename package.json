{
  "name": "agent-v",
  "version": "0.1.0",
  "description": "A provider-neutral engine for building inspectable, extensible agentic products.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vequan23/agent-v.git"
  },
  "homepage": "https://github.com/Vequan23/agent-v#readme",
  "bugs": "https://github.com/Vequan23/agent-v/issues",
  "keywords": ["agents", "ai", "tools", "skills", "local-first", "typescript"],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk/index.d.ts",
      "import": "./dist/adapters/ai-sdk/index.js"
    },
    "./local-cli": {
      "types": "./dist/adapters/local-cli/index.d.ts",
      "import": "./dist/adapters/local-cli/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm pack --dry-run --cache .npm-cache"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "ai": "^7.0.79",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
