{
  "name": "@vraxis/agent-v",
  "version": "0.12.0",
  "description": "A provider-neutral engine for building inspectable, extensible agentic products.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vequan23/agent-v.git"
  },
  "homepage": "https://github.com/Vequan23/agent-v#readme",
  "bugs": "https://github.com/Vequan23/agent-v/issues",
  "keywords": [
    "agents",
    "ai",
    "tools",
    "skills",
    "local-first",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "agent-v": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "compatibility.json",
    "llms.txt",
    "examples",
    "skills",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk/index.d.ts",
      "import": "./dist/adapters/ai-sdk/index.js"
    },
    "./providers": {
      "types": "./dist/adapters/providers/index.d.ts",
      "import": "./dist/adapters/providers/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./tools/node": {
      "types": "./dist/tools/node/index.d.ts",
      "import": "./dist/tools/node/index.js"
    },
    "./local-cli": {
      "types": "./dist/adapters/local-cli/index.d.ts",
      "import": "./dist/adapters/local-cli/index.js"
    },
    "./mcp": {
      "types": "./dist/adapters/mcp/index.d.ts",
      "import": "./dist/adapters/mcp/index.js"
    },
    "./ollama": {
      "types": "./dist/adapters/ollama/index.d.ts",
      "import": "./dist/adapters/ollama/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./compatibility": "./compatibility.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:harness": "node --import tsx --test test/context.test.ts test/harness-conformance.test.ts test/node-tools.test.ts",
    "test:examples": "tsc --noEmit -p examples/tsconfig.json && node --import tsx examples/smoke.ts",
    "test:package": "node test/package-smoke.mjs && node test/package-mcp-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:examples && npm run test:package && npm pack --dry-run --cache .npm-cache"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/deepseek": "^3.0.37",
    "@ai-sdk/google": "^4.0.58",
    "@ai-sdk/openai": "^4.0.52",
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@modelcontextprotocol/client": "^2.0.0",
    "ai": "^7.0.85",
    "ai-sdk-ollama": "^4.2.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
