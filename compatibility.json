{
  "schemaVersion": 1,
  "packageVersion": "0.9.0",
  "node": ">=22.12",
  "adapters": {
    "ai-sdk": {
      "packageRange": ">=7.0.0 <8",
      "capabilities": ["structured-output", "streaming", "tools", "tool-approval", "tool-filtering", "tool-sequencing", "tool-audit", "artifacts"],
      "strategies": [
        "ai-sdk-v7-structured-model",
        "ai-sdk-v7-tool-agent"
      ]
    },
    "providers": {
      "credentialPolicy": "host-resolved-references-only",
      "inspectionPolicy": "configuration-only-no-network",
      "providers": {
        "openai": "ai-sdk-openai-v4",
        "anthropic": "ai-sdk-anthropic-v4",
        "google": "ai-sdk-google-v4",
        "deepseek": "ai-sdk-deepseek-v3",
        "zai": "ai-sdk-openai-compatible-v3",
        "openrouter": "ai-sdk-openai-compatible-v3",
        "groq": "ai-sdk-openai-compatible-v3",
        "openai-compatible": "ai-sdk-openai-compatible-v3"
      }
    },
    "system-credentials": {
      "strategy": "native-os-keyring-v1",
      "platforms": ["darwin", "win32", "linux"],
      "plaintextFallback": false
    },
    "standard-tools": {
      "format": "agent-v-tool-catalog-v1",
      "defaultAuthority": "pure-tools-only",
      "approvalPolicy": "deny-by-default",
      "nodeWorkspacePolicy": "canonical-root-no-symlink-escape-no-root-removal",
      "networkPolicy": "https-or-loopback-explicit-host-allowlist",
      "browserPolicy": "host-controller-explicit-origin-allowlist",
      "tools": ["calculate", "date-time", "validate-json", "list-directory", "find-files", "read-text", "search-text", "write-text", "apply-text-edits", "apply-workspace-patch", "create-directory", "move-path", "remove-path", "git-status", "git-diff", "git-log", "git-show", "run-command", "http-fetch", "browser-snapshot", "browser-console", "browser-screenshot", "browser-wait", "browser-navigate", "browser-click", "browser-type"]
    },
    "starter-recipes": {
      "format": "agent-v-starter-recipes-v1",
      "recipes": ["coding", "planning", "debugging", "research", "review", "security", "frontend", "document"],
      "productInstructionsRequired": true
    },
    "ollama": {
      "aiSdkOllamaRange": ">=4.2.0 <5",
      "aiSdkRange": ">=7.0.0 <8",
      "strategy": "ai-sdk-ollama-v4-native-chat",
      "versionPolicy": "inspect-daemon-and-models-before-each-resolution"
    },
    "local-cli": {
      "discovery": "local-cli-inventory-v1",
      "commandResolution": "ordered-argv-candidates-v1",
      "versionPolicy": "detect-before-each-run-and-invalidate-readiness-on-change",
      "runtimes": {
        "codex": {
          "strategy": "codex-exec-json-v1",
          "capabilities": ["structured-output", "local-workspace", "read-only-workspace", "workspace-write", "artifacts"]
        },
        "opencode": {
          "strategy": "opencode-run-json-v2",
          "capabilities": ["structured-output", "local-workspace", "workspace-write", "artifacts"]
        },
        "claude-code": {
          "strategy": "claude-print-json-v2",
          "capabilities": ["structured-output", "local-workspace", "read-only-workspace", "artifacts"]
        },
        "cursor": {
          "strategy": "cursor-print-json-v2",
          "capabilities": ["structured-output", "local-workspace", "read-only-workspace", "workspace-write", "artifacts"]
        }
      }
    },
    "skill-inventory": {
      "format": "agent-skills-filesystem-v1",
      "runtimes": ["codex", "claude-code", "cursor", "opencode"],
      "remoteSourcePolicy": "record-without-downloading"
    }
  }
}
